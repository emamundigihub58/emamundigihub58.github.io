<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="Emamun Digital Hub creates Pinterest pins, social media graphics and content plans for creators and small businesses.">
<title>Emamun Digital Hub | Pinterest & Content Design</title>
<style>
:root{--ivory:#F8F5F0;--beige:#EFE7DB;--taupe:#DCCFC0;--charcoal:#2D2D2D;--soft:#6B6B6B;--accent:#B8956A;--white:#fff}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:Arial,sans-serif;background:var(--ivory);color:var(--charcoal);line-height:1.7}
a{color:inherit}
.announcement{background:var(--charcoal);color:var(--beige);text-align:center;padding:9px 12px;font-size:11px;letter-spacing:2px}
nav{position:sticky;top:0;z-index:20;background:#f8f5f0f2;backdrop-filter:blur(12px);padding:15px 6%;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--taupe)}
.logo{font:24px Georgia,serif;text-decoration:none}
.logo small{display:block;font:10px Arial,sans-serif;letter-spacing:2px;color:var(--soft)}
.navlinks{display:flex;gap:25px;align-items:center}
.navlinks a{text-decoration:none;font-size:12px;letter-spacing:1px}
.navlinks a:hover{color:var(--accent)}
.menu{display:none;border:0;background:none;font-size:25px}
.hero{min-height:78vh;padding:100px 7%;display:grid;place-items:center;text-align:center;background:linear-gradient(145deg,var(--ivory),var(--beige),var(--taupe))}
.eyebrow,.label{font-size:11px;letter-spacing:3px;text-transform:uppercase;color:var(--accent)}
h1,h2,h3{font-family:Georgia,serif;font-weight:400;line-height:1.2}
h1{font-size:clamp(42px,7vw,76px);max-width:850px;margin:24px auto}
h1 em,h2 em{color:var(--accent)}
.hero p{max-width:620px;margin:0 auto 28px;color:#555}
.actions{display:flex;justify-content:center;gap:12px;flex-wrap:wrap}
.btn{display:inline-block;text-decoration:none;padding:13px 24px;border-radius:30px;background:var(--charcoal);color:white;border:1px solid var(--charcoal);font-size:12px;letter-spacing:1px;cursor:pointer}
.btn.alt{background:transparent;color:var(--charcoal)}
.btn:hover{background:var(--accent);border-color:var(--accent);color:white}
section{padding:85px 7%}
.heading{text-align:center;max-width:700px;margin:0 auto 42px}
.heading h2,.section-title{font-size:clamp(32px,4vw,48px);margin:12px 0}
.heading p,.muted{color:var(--soft)}
.about{background:white;display:grid;grid-template-columns:1fr 1.2fr;gap:45px;align-items:center}
.about-art{min-height:350px;border-radius:20px;background:linear-gradient(145deg,var(--beige),var(--taupe));display:grid;place-items:center;text-align:center;padding:25px}
.about-art strong{font:clamp(32px,5vw,56px) Georgia,serif}
.about-copy p{margin:18px 0;color:#555}
.tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:22px}
.tags span{background:var(--beige);border-radius:30px;padding:7px 13px;font-size:12px}
.portfolio{background:var(--ivory)}
.pin-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}
.pin{background:white;border-radius:18px;overflow:hidden;border:1px solid #e5dbce;box-shadow:0 9px 26px #2d2d2d12;transition:transform .25s ease,box-shadow .25s ease}
.pin:hover{transform:translateY(-5px);box-shadow:0 16px 32px #2d2d2d18}
.pin-foot{background:#fffdf9;border-top:1px solid #e5dbce}
.pa{aspect-ratio:2/3;padding:27px 22px 18px;display:flex;flex-direction:column;position:relative;overflow:hidden;isolation:isolate}
.pa::after{content:"";position:absolute;right:-45px;top:-45px;width:160px;height:160px;border-radius:50%;background:var(--accent);opacity:.13;pointer-events:none;z-index:-1}
.pa::before{position:absolute;pointer-events:none;z-index:0;line-height:1;user-select:none}
.pa.t1{background-image:radial-gradient(ellipse at 92% 24%,#ffffffb8 0 9%,transparent 10%),radial-gradient(ellipse at 100% 31%,#c6b28c55 0 12%,transparent 13%),linear-gradient(165deg,#fbf6ee,#ead9c3)}
.pa.t1::before{content:"✿";right:10px;top:18%;font-size:76px;color:#8c9872;opacity:.55;transform:rotate(16deg);text-shadow:14px 38px 0 #b5a07c55}
.pa.t2{background-image:radial-gradient(ellipse at 92% 30%,#b8956a30 0 2%,transparent 3%),radial-gradient(ellipse at 100% 36%,#b8956a24 0 13%,transparent 14%),linear-gradient(165deg,#38332e,#201d1a)}
.pa.t2::before{content:"✧";right:14px;bottom:17%;font-size:88px;color:#d4b896;opacity:.6;transform:rotate(12deg)}
.pa.t3{background-image:radial-gradient(ellipse at 5% 8%,#fff9f5 0 12%,transparent 13%),radial-gradient(ellipse at 100% 100%,#cf9b8b45 0 18%,transparent 19%),linear-gradient(165deg,#f7ebe6,#e6cdc2)}
.pa.t3::before{content:"❀";right:13px;bottom:7%;font-size:64px;color:#b5634f;opacity:.24;transform:rotate(-18deg)}
.pa.t4{background-image:radial-gradient(ellipse at 0% 10%,#fffaf2 0 10%,transparent 11%),radial-gradient(ellipse at 100% 88%,#a0a98b50 0 16%,transparent 17%),linear-gradient(165deg,#f5ede1,#d9c7b0)}
.pa.t4::before{content:"✧  ✿";right:9px;bottom:4%;font-size:32px;color:#78866b;opacity:.5;transform:rotate(-14deg)}
.pa.t5{background-image:radial-gradient(ellipse at 50% 70%,#ffffff9c 0 20%,transparent 21%),radial-gradient(ellipse at 100% 0%,#b8956a45 0 16%,transparent 17%),linear-gradient(165deg,#fbf7ef,#dccfc0)}
.pa.t5::before{content:"↻";right:8px;top:30%;font-size:84px;color:#b8956a;opacity:.18}
.pa.t6{background-image:radial-gradient(ellipse at 100% 8%,#8b967350 0 17%,transparent 18%),radial-gradient(ellipse at 0% 100%,#d7c6a750 0 20%,transparent 21%),linear-gradient(165deg,#fffefa,#efe7db)}
.pa.t6::before{content:"❧";right:5px;top:10%;font-size:92px;color:#78866b;opacity:.48;transform:rotate(22deg)}
.pa .tag,.pa h3,.pa .sub,.pa .line,.pa ul,.pa .brand,.pa .grid2,.pa .steps,.pa .repeat{position:relative;z-index:1}
.pa .tag{display:inline-flex;align-self:flex-start;border:1px solid currentColor;border-radius:20px;padding:5px 9px;background:#ffffff40;font-size:9px;letter-spacing:2px;text-transform:uppercase;color:var(--accent);font-weight:bold}
.pa h3{font-size:clamp(22px,2.4vw,28px);line-height:1.12;margin:12px 0 7px;max-width:95%;letter-spacing:-.5px}
.pa .sub{font-size:12px;opacity:.82;margin-bottom:14px;line-height:1.45}
.pa .line{width:48px;height:2px;background:var(--accent);margin:0 0 14px;flex-shrink:0}
.pa ul{list-style:none;display:grid;gap:9px;flex:1;align-content:center}
.pa li{display:flex;gap:10px;align-items:flex-start;font-size:12px;line-height:1.35;background:#ffffff58;border:1px solid #ffffff48;border-radius:12px;padding:8px 9px;backdrop-filter:blur(2px)}
.pa li i{font-style:normal;flex:0 0 24px;height:24px;border-radius:50%;background:var(--accent);color:#fff;display:grid;place-items:center;font-size:11px;box-shadow:0 3px 8px #2d2d2d12}
.pa li b{display:block;font-size:12.5px;margin-bottom:2px}
.pa li small{display:block;opacity:.76;font-size:10.5px;line-height:1.35}
.pa .brand{font-size:8px;letter-spacing:2.7px;text-align:center;margin-top:12px;padding-top:9px;border-top:1px solid currentColor;opacity:.7}
.pa .grid2{display:grid;grid-template-columns:1fr 1fr;gap:8px;flex:1;align-content:center}
.pa .grid2 div{background:#fffaf0c9;border:1px solid #ffffffbd;box-shadow:0 4px 12px #2d2d2d0b;border-radius:12px;padding:10px 9px;font-size:10px;line-height:1.35}
.pa .grid2 b{display:block;font-size:11.5px;margin:3px 0}
.pa .steps{display:grid;gap:8px;flex:1;align-content:center}
.pa .steps div{background:#ffffffb8;border:1px solid #ffffffb5;box-shadow:0 4px 12px #2d2d2d0a;border-radius:12px;padding:10px 12px;font-size:13px;display:flex;gap:12px;align-items:center}
.pa .steps small{font-size:9px;letter-spacing:2px;color:var(--accent);font-weight:bold;flex:0 0 52px}
.pa .repeat{text-align:center;font-size:12px;color:var(--accent);margin-top:10px}
.pa .tag{font-size:10px;letter-spacing:2.5px;text-transform:uppercase;color:var(--accent);font-weight:bold;position:relative;z-index:1}
.pa h3{font-size:clamp(22px,2.4vw,28px);line-height:1.15;margin:10px 0 6px;position:relative;z-index:1}
.pa .sub{font-size:12px;opacity:.75;margin-bottom:14px;position:relative;z-index:1}
.pa .line{width:44px;height:2px;background:var(--accent);margin:0 0 14px;flex-shrink:0}
.pa ul{list-style:none;display:grid;gap:9px;flex:1;align-content:center;position:relative;z-index:1}
.pa li{display:flex;gap:10px;align-items:flex-start;font-size:12px;line-height:1.35}
.pa li i{font-style:normal;flex:0 0 24px;height:24px;border-radius:50%;background:var(--accent);color:#fff;display:grid;place-items:center;font-size:11px}
.pa li b{display:block;font-size:12.5px}
.pa li small{display:block;opacity:.7;font-size:11px}
.pa .brand{font-size:9px;letter-spacing:3px;text-align:center;margin-top:12px;opacity:.65;position:relative;z-index:1}
.pa .grid2{display:grid;grid-template-columns:1fr 1fr;gap:8px;flex:1;align-content:center;position:relative;z-index:1}
.pa .grid2 div{background:#ffffffa6;border-radius:10px;padding:9px 10px;font-size:11px;line-height:1.3}
.pa .grid2 b{display:block;font-size:11.5px}
.pa .steps{display:grid;gap:8px;flex:1;align-content:center;position:relative;z-index:1}
.pa .steps div{background:#ffffffb8;border-radius:12px;padding:10px 14px;font-size:13px;display:flex;gap:12px;align-items:center}
.pa .steps small{font-size:9px;letter-spacing:2px;color:var(--accent);font-weight:bold;flex:0 0 52px}
.pa .repeat{text-align:center;font-size:12px;color:var(--accent);margin-top:10px;position:relative;z-index:1}
.t1{background:linear-gradient(165deg,#fbf6ee,#ead9c3);color:#2d2d2d}
.t2{background:linear-gradient(165deg,#38332e,#201d1a);color:#f8f5f0}
.t2 .tag{color:#d4b896}
.t2 .line{background:#d4b896}
.t3{background:linear-gradient(165deg,#f7ebe6,#e6cdc2);color:#3a2b26}
.t3 .tag{color:#a8523f}
.t3 li i{background:#b5634f}
.t3 .line{background:#b5634f}
.t4{background:linear-gradient(165deg,#efe7db,#d9c7b0);color:#2d2d2d}
.t5{background:linear-gradient(165deg,#f8f5f0,#dccfc0);color:#2d2d2d}
.t6{background:linear-gradient(165deg,#ffffff,#efe7db);color:#2d2d2d}
.pin-foot{padding:13px 16px;display:flex;align-items:center;justify-content:space-between;font-size:12px}
.philosophy{background:var(--charcoal);color:var(--ivory)}
.philosophy .heading p{color:#d1c7bb}
.phil-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.phil-card{padding:24px;border:1px solid #ffffff20;border-radius:15px}
.phil-card .num{font:38px Georgia,serif;color:var(--accent)}
.phil-card h3{font-size:21px;margin:15px 0}
.phil-card p{font-size:13px;color:#d0cbc5}
.services{background:var(--beige)}
.service-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}
.service-card{background:white;border:1px solid #dfd3c4;border-radius:18px;padding:27px;display:flex;flex-direction:column}
.service-card.featured{background:var(--charcoal);color:var(--ivory)}
.badge{display:inline-block;font-size:10px;letter-spacing:2px;text-transform:uppercase;background:var(--beige);padding:6px 10px;border-radius:20px;align-self:flex-start}
.featured .badge{background:#ffffff20;color:var(--ivory)}
.service-card h3{font-size:27px;margin:18px 0 8px}
.price{font-size:29px;font-weight:bold;margin:8px 0}
.price small{font-size:13px;font-weight:normal}
.service-card p{font-size:13px;color:var(--soft)}
.featured p{color:#d0cbc5}
.service-card ul{list-style:none;margin:20px 0;flex:1}
.service-card li{font-size:13px;padding:7px 0;border-bottom:1px solid #b8956a2a}
.service-card li:before{content:"✦ ";color:var(--accent)}
.service-card .btn{display:block;text-align:center;margin-top:12px}
.note{font-size:11px!important;margin-top:14px;color:var(--soft)}
.featured .note{color:#d0cbc5}
.process{background:white;text-align:center}
.process-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:35px}
.process-card{background:var(--ivory);padding:25px;border-radius:14px}
.process-card h3{font-size:22px;margin:10px 0}
.process-card p{font-size:13px;color:var(--soft)}
.contact{background:linear-gradient(140deg,var(--beige),var(--taupe))}
.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:45px;align-items:start}
.contact-copy p{margin:18px 0;color:#555}
.contact-links{display:grid;gap:12px;margin-top:25px}
.contact-links a{background:#ffffffa8;padding:14px 17px;border-radius:12px;text-decoration:none}
.contact-links a:hover{background:white}
.form{background:white;padding:28px;border-radius:18px}
.form label{display:block;font-size:11px;letter-spacing:1px;text-transform:uppercase;margin:14px 0 6px}
.form input,.form select,.form textarea{width:100%;padding:13px;border:1px solid var(--taupe);border-radius:9px;background:var(--ivory);font:14px Arial}
.form textarea{min-height:120px;resize:vertical}
.form button{width:100%;margin-top:18px}
.form-help{font-size:11px;color:var(--soft);margin-top:12px}
footer{background:var(--charcoal);color:#ddd;padding:35px 7%;display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}
footer a{color:var(--beige)}
@media(max-width:850px){
 .navlinks{gap:12px}
 .about,.contact-grid{grid-template-columns:1fr}
 .service-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
 .phil-grid{grid-template-columns:repeat(2,1fr)}
 .pin-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media(max-width:600px){
 nav{padding:13px 5%}
 .menu{display:block}
 .navlinks{display:none;position:absolute;top:100%;left:0;right:0;padding:20px;background:var(--ivory);flex-direction:column;align-items:stretch;border-bottom:1px solid var(--taupe)}
 .navlinks.open{display:flex}
 .navlinks a{padding:8px}
 section{padding:60px 5%}
 .hero{min-height:70vh;padding:75px 6%}
